# Configuracion de Apache para el alojamiento. Vite copia este fichero a dist/
# tal cual, asi que basta con subir el contenido de dist/ a la raiz web (www/).

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # La validacion de certificados SSL (Let's Encrypt) tiene que resolverse
  # contra ficheros reales: si no existen debe devolver 404, no el index.
  RewriteRule ^\.well-known/ - [L]

  # Los ficheros y carpetas que existen se sirven tal cual.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # El resto de rutas (/about-us, /team, /products-services/...) las resuelve el
  # router de React. Sin esto, entrar directo o recargar devuelve un 404.
  RewriteRule . /index.html [L]

  # Redireccion a HTTPS. Descomentar SOLO cuando el certificado este activo:
  # con el certificado sin emitir, esto deja la web inaccesible.
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  # Los assets del build llevan hash en el nombre: cambian de nombre al cambiar
  # de contenido, asi que se pueden cachear indefinidamente.
  <FilesMatch "\.(js|css|woff2?|jpe?g|png|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # index.html y los JSON de traducciones NO llevan hash: si se cachean, los
  # cambios de texto no llegan a los visitantes.
  <FilesMatch "\.(html|json|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Evita que se listen los directorios que no tengan index.
Options -Indexes
