# ---------------------------------------------------------------
# SPA React (Vite) - sysoil.es
# ---------------------------------------------------------------

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forzar HTTPS.
  # OJO: aqui NO sirve %{HTTPS}. El TLS lo termina un proxy delantero que
  # habla con Apache por el puerto 80, asi que mod_ssl siempre reporta "off"
  # y usar %{HTTPS} provoca un bucle infinito de 301.
  # El proxy si envia X-Forwarded-Proto (https / http), verificado el 14/09/2026.
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Forzar www -> sin www (opcional)
  # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  # RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # Nunca interceptar la validacion de Let's Encrypt (renovaciones incluidas)
  RewriteRule ^\.well-known/ - [L]

  # Si el fichero o directorio existe, se sirve tal cual
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Cualquier otra ruta la resuelve React Router
  RewriteRule ^ index.html [L]
</IfModule>

# Compresion
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Cache: los assets de Vite llevan hash en el nombre -> cache larga
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# index.html y traducciones: nunca cachear (para que los deploys se vean al instante)
<FilesMatch "^(index\.html|site\.webmanifest)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, must-revalidate"
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  <FilesMatch "\.json$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# MIME types por si el servidor no los trae
<IfModule mod_mime.c>
  AddType application/json .json
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType image/svg+xml .svg
</IfModule>

ErrorDocument 404 /index.html
